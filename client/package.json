{
  "name": "kapitan",
  "publisher": "kapicorp",
  "displayName": "Kapitan Language Server",
  "description": "A Language Server for github.com/kapicorp/kapitan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kapicorp/kapitan-vscode-extension"
  },
  "version": "0.0.0+dynamic-from-tags",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:yaml"
  ],
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "properties": {
        "kapitan.inventoryPath": {
          "type": "string",
          "default": "inventory",
          "markdownDescription": "Inventory path, relative to the workspace root"
        },
        "kapitan.YAMLExtension": {
          "default": "yml",
          "markdownDescription": "The extesion of classes and targets in the inventory",
          "enum": [
            "yml",
            "yaml"
          ]
        },
        "kapitan.showDebugLogs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Whether to show debug logs or not"
        }
      }
    },
    "languages": [
      {
        "id": "yaml",
        "aliases": [
          "YAML",
          "yaml"
        ],
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "./prepublish.sh",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "webpack": "webpack --mode development",
    "vscepack": "vsce package",
    "postinstall": "echo post-install"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.7",
    "@types/vscode": "^1.94.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.105.2",
    "webpack-cli": "^5.1.4"
  }
}
